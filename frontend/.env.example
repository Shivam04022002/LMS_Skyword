# Base URL of the LMS API, including the /api prefix.
# Read at BUILD time by Vite, so a production bundle must be built with the
# production value present — see below.

# Local development (`npm run dev` reads frontend/.env):
VITE_API_URL=http://localhost:5000/api

# Production: create frontend/.env.production on the server with
#   VITE_API_URL=https://api.lms.skyword.com/api
# and then run `npm run build`. That file is deliberately not committed
# (.gitignore excludes .env.*), so it must exist on the build host.
