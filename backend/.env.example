NODE_ENV=development
PORT=5000

# MySQL. In production the database runs on the same host as the API, so
# localhost is the correct value there too — it is not a leftover dev setting.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lms
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1d

# Browser origins allowed to call this API, comma-separated. No trailing slash.
# Local development:
FRONTEND_URL=http://localhost:5173,http://localhost:5174
# Production (set this in backend/.env on the server):
#   FRONTEND_URL=https://lms.skyword.com
# To allow a developer's Vite server to reach the production API as well:
#   FRONTEND_URL=https://lms.skyword.com,http://localhost:5173

# Used only by `npm run seed:admin` to create the first administrator.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me
