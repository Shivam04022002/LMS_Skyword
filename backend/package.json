{
  "name": "lms-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Loan Management System - Backend API",
  "main": "src/server.js",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "db:create": "node src/utils/createDatabase.js",
    "db:migrate": "node src/utils/migrate.js up",
    "db:migrate:status": "node src/utils/migrate.js status",
    "db:migrate:undo": "node src/utils/migrate.js down",
    "seed:rbac": "node src/utils/seedRbac.js",
    "seed:admin": "node src/utils/seedAdmin.js",
    "seed": "npm run seed:rbac && npm run seed:admin",
    "test:offline": "node tests/offline.test.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.12.0",
    "sequelize": "^6.37.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  },
  "engines": {
    "node": ">=18"
  }
}
